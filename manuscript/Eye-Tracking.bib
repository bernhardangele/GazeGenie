@phdthesis{goldenbergMeasuredPerceivedImpact2022,
  type = {{{MSc}}. {{Thesis}}},
  title = {Measured and Perceived Impact of Noise during Reading. {{An}} Eye Tracking Study.},
  author = {Goldenberg, Victoria},
  year = {2022},
  month = aug,
  abstract = {Previous research has shown that performance of cognitive tasks can deteriorate if an irrelevant noise is present during the focal task. Understanding the influence of irrelevant noise on productivity is especially relevant for those working in noisy environments like open-plan offices. The present study was conducted to examine the comprehension accuracy and eye-movement behaviour during reading in different sound conditions: silence, quiet office and busy office. The sound stimuli consisted of office related noises and did not include speech. Participants were also asked to estimate their comprehension accuracy after answering comprehension questions. This was meant to investigate whether participants' measured accuracy was different to what they expected to achieve in each of the noise conditions. The results have shown that the participants expected to have poorer performance when exposed to noise, however their comprehension scores did not differ significantly. Reading behaviour showed negligible differences in fixation duration and saccade length; and no difference in gaze duration; while regression probability saw an increase both in the quiet office (4.5\%) and in the busy office condition (5.5\%) compared to the silent control. The results are in line with the previous research which found no detrimental effect of irrelevant sounds on reading comprehension. It is suggested that future research compares participants' self-reported and measured performance on other cognitive tasks when exposed to noise.},
  school = {Bournemouth University}
}

