  urldate = {2023-01-19},
  abstract = {A novel ordinal regression algorithm, called moving window regression (MWR), is proposed in this paper. First, we propose the notion of relative rank (\${\textbackslash}rho\$-rank), which is a new order representation scheme for input and reference instances. Second, we develop global and local relative regressors (\${\textbackslash}rho\$-regressors) to predict \${\textbackslash}rho\$-ranks within entire and specific rank ranges, respectively. Third, we refine an initial rank estimate iteratively by selecting two reference instances to form a search window and then estimating the \${\textbackslash}rho\$-rank within the window. Extensive experiments results show that the proposed algorithm achieves the state-of-the-art performances on various benchmark datasets for facial age estimation and historical color image classification. The codes are available at https://github.com/nhshin-mcl/MWR.},
