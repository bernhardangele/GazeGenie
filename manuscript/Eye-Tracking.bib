@article{scherrTextMattersEye2016,
  title = {The {{Text Matters}}: {{Eye Movements Reflect}} the {{Cognitive Processing}} of {{Interrogation Rights}}},
  shorttitle = {The {{Text Matters}}},
  author = {Scherr, Kyle C. and Agauas, Stephen J. and Ashby, Jane},
