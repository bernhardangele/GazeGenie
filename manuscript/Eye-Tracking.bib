@phdthesis{seymourUsingEyeTrackingTechnology2022,
  type = {{{MSc}}. {{Thesis}}},
  title = {Using {{Eye-Tracking Technology}} to {{Measure}} the {{Effect}} of {{Political Ideology}} on {{Comprehension}} of {{Online News Articles}}},
  author = {Seymour, Harry Seth},
  year = {2022},
  month = aug,
  abstract = {It has been reported that there is a growing decline, internationally, in the amount of trust that people place in the news. Social media was found to be the least trustworthy source of news reporting but despite this, there is an increasing number of people using social media as their primary news source. Data revealing the average length of time that people spend looking at social media posts indicates that people are cherry picking news articles that are relevant to them and that support their own beliefs. Previous research has investigated what causes individuals to interact with an online article, but limited research has examined what factors determine a person's comprehension of the article. Eye-tracking research has been used to find that the perspective with which a participant reads text determines their comprehension. This study investigated whether the political ideology of the participant would serve as a reading perspective sufficiently enough to affect comprehension when reading politically charged text passages. Results showed that if the political ideology did not match that of the author attributed to a key factual statement, then participant comprehension of the statement would be lower. This effect was significantly greater if the author was referenced before the statement. It is explored how these results can be used to help reduce, and raise awareness, of fake news in modern online media, as well as how further research could reveal additional factors that affect reading comprehension of politically charged articles.},
  school = {Bournemouth University}
}

@misc{shiDeepNeuralNetworks2022,
  title = {Deep {{Neural Networks}} for {{Rank-Consistent Ordinal Regression Based On Conditional Probabilities}}},
  author = {Shi, Xintong and Cao, Wenzhi and Raschka, Sebastian},
  year = {2022},
  month = sep,
  number = {arXiv:2111.08851},
  eprint = {2111.08851},
  primaryclass = {cs, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2111.08851},
  urldate = {2022-12-15},
  abstract = {In recent times, deep neural networks achieved outstanding predictive performance on various classification and pattern recognition tasks. However, many real-world prediction problems have ordinal response variables, and this ordering information is ignored by conventional classification losses such as the multi-category cross-entropy. Ordinal regression methods for deep neural networks address this. One such method is the CORAL method, which is based on an earlier binary label extension framework and achieves rank consistency among its output layer tasks by imposing a weight-sharing constraint. However, while earlier experiments showed that CORAL's rank consistency is beneficial for performance, \{it is limited by a weight-sharing constraint in a neural network's fully connected output layer. We propose a new method for rank-consistent ordinal regression without this limitation. Our rank-consistent ordinal regression framework (CORN) achieves rank consistency by a novel training scheme. This training scheme uses\} conditional training sets to obtain the unconditional rank probabilities through applying the chain rule for conditional probability distributions. Experiments on various datasets demonstrate the efficacy of the proposed method to utilize the ordinal target information, and the absence of the weight-sharing restriction improves the performance substantially compared to the CORAL reference approach.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {G\:\\Zotero Backup\\storage\\AC56392R\\Shi et al. - 2022 - Deep Neural Networks for Rank-Consistent Ordinal R.pdf;G\:\\Zotero Backup\\storage\\SLLBNSJG\\2111.html;G\:\\Zotero Backup\\storage\\WCVG3XBQ\\2111.html}
}

@article{shiDeepNeuralNetworks2023,
  title = {Deep Neural Networks for Rank-Consistent Ordinal Regression Based on Conditional Probabilities},
  author = {Shi, Xintong and Cao, Wenzhi and Raschka, Sebastian},
  year = {2023},
  month = aug,
  journal = {Pattern Analysis and Applications},
  volume = {26},
  number = {3},
  pages = {941--955},
  issn = {1433-755X},
  doi = {10.1007/s10044-023-01181-9},
  urldate = {2024-07-03},
  abstract = {In recent times, deep neural networks achieved outstanding predictive performance on various classification and pattern recognition tasks. However, many real-world prediction problems have ordinal response variables, and this ordering information is ignored by conventional classification losses such as the multi-category cross-entropy. Ordinal regression methods for deep neural networks address this. One such method is the CORAL method, which is based on an earlier binary label extension framework and achieves rank consistency among its output layer tasks by imposing a weight-sharing constraint. However, while earlier experiments showed that CORAL's rank consistency is beneficial for performance, it is limited by a weight-sharing constraint in a neural network's fully connected output layer, which may restrict the expressiveness and capacity of a network trained using CORAL. We propose a new method for rank-consistent ordinal regression without this limitation. Our rank-consistent ordinal regression framework (CORN) achieves rank consistency by a novel training scheme. This training scheme uses conditional training sets to obtain the unconditional rank probabilities through applying the chain rule for conditional probability distributions. Experiments on various datasets demonstrate the efficacy of the proposed method to utilize the ordinal target information, and the absence of the weight-sharing restriction improves the performance substantially compared to the CORAL reference approach. Additionally, the suggested CORN method is not tied to any specific architecture and can be utilized with any deep neural network classifier to train it for ordinal regression tasks.},
  langid = {english},
  keywords = {Artificial intelligence,Convolutional neural networks,Deep learning,Ordinal regression},
  file = {G:\Zotero Backup\storage\7ABQTBD2\Shi et al. - 2023 - Deep neural networks for rank-consistent ordinal r.pdf}
}

