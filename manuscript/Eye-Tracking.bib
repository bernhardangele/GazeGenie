}

@article{vajsSpatiotemporalEyeTrackingFeature2022,
  title = {Spatiotemporal {{Eye-Tracking Feature Set}} for {{Improved Recognition}} of {{Dyslexic Reading Patterns}} in {{Children}}},
  author = {Vajs, Ivan and Kovi{\'c}, Vanja and Papi{\'c}, Tamara and Savi{\'c}, Andrej M. and Jankovi{\'c}, Milica M.},
  year = {2022},
